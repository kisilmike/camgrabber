# Куда сохранять снимки (папка на хосте)
TIMELAPSE_PATH=/mnt/nas/timelapse
# На каком адресе и порту хоста открыть админ-страницу (127.0.0.1 - только с самого сервера)
BIND_IP=127.0.0.1
HOST_PORT=8099
# 1 - чистка только считает, что удалила бы; 0 - реально удаляет (включайте после проверки)
CLEAN_DRY_RUN=1
